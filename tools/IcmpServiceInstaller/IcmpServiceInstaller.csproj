<Project Sdk="Microsoft.NET.Sdk">
  <!-- nattunnel-icmp-service.exe — the standalone WinDivert persistent-service registrator an embedded
       integrator runs ONCE (elevated) from their installer, so the unprivileged host game can use the ICMP
       transport at runtime. Bundled with the NuGet under tools/. Links the installer logic from the library. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>nattunnel-icmp-service</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- Ships inside a NuGet package next to a consumer's app, so it must not depend on a matching .NET runtime
         being installed, and it should be ONE file rather than scattering DLLs into their output directory.
         WinDivert.dll/.sys stay loose beside it deliberately — WinDivert resolves the driver by path at load
         time, so they cannot be embedded. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trimmed: this ships inside a NuGet package, so size matters. The tool only touches SCM P/Invoke,
         ServiceBase and Console — no reflection-driven paths for the trimmer to miss. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <!-- Manifest: request admin so double-clicking / installer-invoke triggers UAC (installing a kernel-driver
       service is privileged). Integrators invoking from an already-elevated installer get no extra prompt. -->
  <ItemGroup>
    <Content Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the library's installer logic (source-linked; it's public but self-contained). -->
    <Compile Include="..\..\NATTunnel\Icmp\WinDivertServiceInstaller.cs" Link="WinDivertServiceInstaller.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- ServiceBase, for the boot keeper that re-applies the device DACL after every driver load. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
  </ItemGroup>

  <!-- The driver must sit next to this exe so ResolveDriverPath finds it. -->
  <ItemGroup>
    <Content Include="..\..\lib\win-x64\WinDivert64.sys">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>WinDivert64.sys</Link>
    </Content>
    <Content Include="..\..\lib\win-x64\WinDivert.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>WinDivert.dll</Link>
    </Content>
  </ItemGroup>
</Project>
